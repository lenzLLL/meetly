{
  "name": "meet-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "analyze-pdf": "node scripts/extract-and-analyze.js",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron:prod": "electron .",
    "package:desktop": "electron-builder --dir",
    "dist:desktop": "electron-builder"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@clerk/nextjs": "^6.36.5",
    "@hookform/resolvers": "^5.2.2",
    "@pinecone-database/pinecone": "^6.1.2",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.11.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/next-pwa": "^5.6.9",
    "@types/nodemailer": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.544.0",
    "micro": "^10.0.1",
    "next": "^16.1.1",
    "next-intl": "^4.3.9",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "nextjs": "^0.0.3",
    "nodemailer": "^7.0.9",
    "openai": "^6.7.0",
    "pdf-parse": "^1.1.4",
    "prisma": "^6.19.1",
    "react": "19.1.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.1.0",
    "react-h5-audio-player": "^3.10.1",
    "react-hook-form": "^7.66.0",
    "resend": "^6.2.0",
    "sonner": "^2.0.7",
    "stripe": "^18.3.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.11",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "svix": "^1.76.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.yourcompany.meetly",
    "productName": "Meetly",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "icon": "assets/icons/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icon.png"
    }
  }
}
